
name: OG WARRIORS APK Build

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Check Project
        run: |
          echo "Checking Og-main folder"
          ls -la ./Og-main
          test -f ./Og-main/settings.gradle.kts || test -f ./Og-main/settings.gradle

      - name: Build APK
        working-directory: ./Og-main
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: OG-WARRIORS-APK
          path: '**/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
